#!/bin/bash
set -e

ip addr add 10.0.0.3/24 dev eth0 # set IP address
rm -f /etc/resolv.conf
echo "nameserver 10.0.0.184" > /etc/resolv.conf  # dns1 IP
ip route add default via 10.0.0.132 # set default gateway to web1

echo "nameserver 8.8.8.8" > /etc/resolv.conf # use public DNS for installation
# without public DNS, apt-get will fail

# wait for internet connectivity (web1 needs to come up)
echo "Waiting for internet connectivity..."
while ! ping -c 1 8.8.8.8 > /dev/null 2>&1; do
    sleep 1
done
echo "Internet connected"

# install dependencies
apt-get update
apt-get install -y python3-scapy net-tools iproute2 python3-pip python3-netifaces

# install Python packages via pip
pip3 install requests netifaces --break-system-packages

# switch back to internal DNS for the lab environment
echo "nameserver 10.0.0.184" > /etc/resolv.conf

chmod +x *.py

echo "[+] Attacker machine ready"
echo "[+] Network discovery module available"
echo "[+] Run 'python3 exploit.py --auto-discover' for interactive mode"


