#!/bin/bash
set -e

ip addr add 10.0.0.3/24 dev eth0 # set IP address
rm -f /etc/resolv.conf
echo "nameserver 10.0.0.2" > /etc/resolv.conf  # dns1 IP
ip route add default via 10.0.0.1 # set default gateway to web1

echo "nameserver 8.8.8.8" > /etc/resolv.conf # use public DNS for installation
# without public DNS, apt-get will fail

# wait for internet connectivity (web1 needs to come up)
echo "Waiting for internet connectivity..."
while ! ping -c 1 8.8.8.8 > /dev/null 2>&1; do
    sleep 1
done
echo "Internet connected"

# install dependencies
apt-get update
apt-get install -y python3-scapy net-tools iproute2 python3-pip

# install Python packages via pip
pip3 install requests --break-system-packages

# switch back to internal DNS for the lab environment
echo "nameserver 10.0.0.2" > /etc/resolv.conf

chmod +x *.py

